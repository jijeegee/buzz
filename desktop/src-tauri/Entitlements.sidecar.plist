<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sidecars in Contents/MacOS (kuzz-acp, kuzz, ...). Never add the
         restricted keys of Entitlements.signed.plist here: a bare executable
         has no provisioning profile, so macOS kills it at launch (SIGKILL).
         Sidecars reach the device key through the app signer instead. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
