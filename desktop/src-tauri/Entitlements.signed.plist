<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- MeshLLM installs versioned native runtimes outside the app bundle. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Secure Enclave device key (docs/apple-device-keys.md). Restricted
         entitlements: only valid with the embedded provisioning profile, so
         this file is used only through tauri.macos-signed.conf.json. -->
    <key>com.apple.application-identifier</key>
    <string>BQ75Y6QK8F.app.kuzz.app</string>
    <key>com.apple.developer.team-identifier</key>
    <string>BQ75Y6QK8F</string>
    <!-- First group wins for newly created keys; the demo group follows so a
         Mac that already holds a Secure Enclave key under the old app id keeps
         using it instead of enrolling as a new device. The profile grants
         `BQ75Y6QK8F.*`, so both are covered. -->
    <key>keychain-access-groups</key>
    <array>
        <string>BQ75Y6QK8F.app.kuzz.app</string>
        <string>BQ75Y6QK8F.app.kuzz.app.demo.preview-88ecaf8be554431e</string>
    </array>
</dict>
</plist>
