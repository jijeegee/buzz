      "expect": {
        "events": ["a1", "a2", "b1", "c3", "d1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]] }
      }
    },
    {
      "name": "a list keeping every room changes nothing, also when repeated",
      "steps": [
