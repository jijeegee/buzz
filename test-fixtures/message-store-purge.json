{
  "description": "Forgetting a room's stored copy (docs/message-sync.md#forgetting-a-room). Each case starts from `seed` in a fresh file of `account`: its `events`, its `coverage`, then its `list` applied as the first membership list (only recorded), unless the case says `seed_list: false`. Then `steps` run in order: `events` are received (socket, query answer, older page or catch-up alike); `capture` takes a named capture now (a live REQ's EOSE, or the start of a membership fetch); `coverage` records a span captured at `captured` (default: now); `forget_except` is a successful membership list fetched from `captured` on (default: now; `null`: the list failed, nothing is called) under the current scope or a `stale` one (account or server switched, signed out), and `refused` says whether the store turns it down; `restart` reopens the file in a new store (captures do not outlive it). `relay_key_known: false` means the client has not learned the relay's signing key. `expect` is the file afterwards: event ids, ids of overlays with targets rows, summary roots, coverage per room. Read by desktop (message_store/tests.rs) and mobile (message_store_purge_test.dart).",
  "account": "aa00000000000000000000000000000000000000000000000000000000000001",
  "relay_key": "cc00000000000000000000000000000000000000000000000000000000000003",
  "seed": {
    "events": [
      { "id": "a1", "kind": 9, "pubkey": "p1", "created_at": 100, "tags": [["h", "room-a"]], "content": "root" },
      { "id": "a2", "kind": 9, "pubkey": "p1", "created_at": 150, "tags": [["h", "room-a"], ["e", "a1", "", "root"], ["e", "a1", "", "reply"]], "content": "reply" },
      { "id": "x1", "kind": 7, "pubkey": "p2", "created_at": 110, "tags": [["e", "a1"]], "content": "+" },
      { "id": "d1", "kind": 9005, "pubkey": "p1", "created_at": 160, "tags": [["h", "room-a"], ["e", "a2"]], "content": "" },
      { "id": "s1", "kind": 39005, "pubkey": "cc00000000000000000000000000000000000000000000000000000000000003", "created_at": 155, "tags": [["e", "a1"], ["h", "room-a"]], "content": "{\"reply_count\":1}" },
      { "id": "b1", "kind": 9, "pubkey": "p1", "created_at": 120, "tags": [["h", "room-b"]], "content": "b" },
      { "id": "y1", "kind": 7, "pubkey": "p2", "created_at": 125, "tags": [["e", "b1"]], "content": "+" },
      { "id": "c1", "kind": 9, "pubkey": "p1", "created_at": 130, "tags": [["h", "room-c"]], "content": "archived" }
    ],
    "coverage": [{ "rooms": ["room-a", "room-b", "room-c"], "from": 100, "to": 200 }],
    "list": ["room-a", "room-b", "room-c"]
  },
  "cases": [
    {
      "name": "seed only",
      "steps": [],
      "expect": {
        "events": ["a1", "a2", "b1", "c1", "d1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "access loss: a kept room the list drops loses its rows, overlays, summaries and coverage; an archived room in the list stays",
      "steps": [{ "forget_except": ["room-b", "room-c"], "refused": false }],
      "expect": {
        "events": ["b1", "c1", "y1"],
        "targets": ["y1"],
        "summaries": [],
        "coverage": { "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "a list from a stale scope is refused",
      "steps": [{ "forget_except": ["room-b"], "scope": "stale", "refused": true }],
      "expect": {
        "events": ["a1", "a2", "b1", "c1", "d1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "an empty list never purges",
      "steps": [{ "forget_except": [], "refused": true }],
      "expect": {
        "events": ["a1", "a2", "b1", "c1", "d1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "a failed list never purges",
      "steps": [{ "forget_except": null }],
      "expect": {
        "events": ["a1", "a2", "b1", "c1", "d1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "first list (none kept yet, as after an upgrade) is only recorded; the next one forgets the rooms it drops",
      "seed_list": false,
      "steps": [
        { "forget_except": ["room-b", "room-c"], "refused": false },
        { "forget_except": ["room-a", "room-b"], "refused": false }
      ],
      "expect": {
        "events": ["a1", "a2", "b1", "d1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]] }
      }
    },
    {
      "name": "a room no list had (an open channel only browsed) is not forgotten by a list",
      "steps": [
        {
          "events": [
            { "id": "o1", "kind": 9, "pubkey": "p1", "created_at": 170, "tags": [["h", "room-o"]], "content": "browsed" }
          ]
        },
        { "forget_except": ["room-a", "room-b", "room-c"], "refused": false },
        { "forget_except": ["room-a", "room-b"], "refused": false }
      ],
      "expect": {
        "events": ["a1", "a2", "b1", "d1", "o1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]] }
      }
    },
    {
      "name": "fence: a span captured before a purge is refused for the forgotten room only; spans captured after it are kept, however early they start, also after a restart",
      "steps": [
        { "capture": "eose" },
        { "forget_except": ["room-b", "room-c"], "refused": false },
        { "coverage": { "rooms": ["room-a", "room-b"], "from": 150, "to": 300, "captured": "eose" } },
        { "coverage": { "rooms": ["room-a"], "from": 180, "to": 400 } },
        { "restart": true },
        { "coverage": { "rooms": ["room-a"], "from": 50, "to": 60 } }
      ],
      "expect": {
        "events": ["b1", "c1", "y1"],
        "targets": ["y1"],
        "summaries": [],
        "coverage": { "room-a": [[50, 60], [180, 400]], "room-b": [[100, 300]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "join during the fetch: a kept room first written after the list's fetch began is not forgotten, and stays kept for the next list",
      "steps": [
        { "forget_except": ["room-a", "room-b", "room-c", "room-m"], "refused": false },
        { "capture": "fetch" },
        {
          "events": [
            { "id": "m1", "kind": 9, "pubkey": "p1", "created_at": 170, "tags": [["h", "room-m"]], "content": "back in" }
