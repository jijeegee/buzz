            { "id": "j1", "kind": 40099, "pubkey": "cc00000000000000000000000000000000000000000000000000000000000003", "created_at": 140, "tags": [["h", "room-a"]], "content": "{\"type\":\"member_joined\",\"actor\":\"bb00000000000000000000000000000000000000000000000000000000000002\",\"target\":\"aa00000000000000000000000000000000000000000000000000000000000001\"}" }
