      ],
      "expect": {
        "events": ["a1", "a2", "b1", "c1", "d1", "m1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "a new room stored between two lists is kept when the next list has it",
      "steps": [
        {
          "events": [
            { "id": "n1", "kind": 9, "pubkey": "p1", "created_at": 170, "tags": [["h", "room-n"]], "content": "new room" }
          ]
        },
        { "forget_except": ["room-a", "room-b", "room-c", "room-n"], "refused": false }
      ],
      "expect": {
        "events": ["a1", "a2", "b1", "c1", "d1", "n1", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "rejoin by list: rows stored for a room a list dropped are forgotten when a list has it again, once, also across a restart",
      "steps": [
