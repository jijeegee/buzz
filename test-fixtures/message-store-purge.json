        {
          "events": [
            { "id": "h1", "kind": 40099, "pubkey": "cc00000000000000000000000000000000000000000000000000000000000003", "created_at": 200, "tags": [["h", "room-a"]], "content": "{\"type\":\"history_changed\",\"actor\":\"bb00000000000000000000000000000000000000000000000000000000000002\",\"history\":\"since_join\"}" }
          ]
        }
      ],
      "expect": {
        "events": ["a1", "a2", "b1", "c1", "d1", "h1", "h2", "x1", "y1"],
        "targets": ["d1", "x1", "y1"],
        "summaries": ["a1"],
        "coverage": { "room-a": [[100, 200]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "since_join forgets only rows older than the notice: newer ones were sent under the new rule, and a span captured after it vouches for them",
      "steps": [
        {
          "events": [
            { "id": "a9", "kind": 9, "pubkey": "p1", "created_at": 400, "tags": [["h", "room-a"]], "content": "after" }
          ]
        },
        {
          "events": [
            { "id": "h1", "kind": 40099, "pubkey": "cc00000000000000000000000000000000000000000000000000000000000003", "created_at": 300, "tags": [["h", "room-a"]], "content": "{\"type\":\"history_changed\",\"actor\":\"bb00000000000000000000000000000000000000000000000000000000000002\",\"history\":\"since_join\"}" }
          ]
        },
        { "coverage": { "rooms": ["room-a"], "from": 350, "to": 500 } }
      ],
      "expect": {
        "events": ["a9", "b1", "c1", "h1", "y1"],
        "targets": ["y1"],
        "summaries": [],
        "coverage": { "room-a": [[350, 500]], "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "a room-less deletion naming rows of two rooms stays when only one room is forgotten",
      "steps": [
        {
          "events": [
            { "id": "k1", "kind": 5, "pubkey": "p1", "created_at": 170, "tags": [["e", "a1"], ["e", "b1"]], "content": "" }
          ]
        },
        { "forget_except": ["room-b", "room-c"], "refused": false }
      ],
      "expect": {
        "events": ["b1", "c1", "k1", "y1"],
        "targets": ["k1", "y1"],
        "summaries": [],
        "coverage": { "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    },
    {
      "name": "a list equal to the kept one still forgets a kept room a leave notice marked",
      "steps": [
        {
          "events": [
            { "id": "l1", "kind": 40099, "pubkey": "cc00000000000000000000000000000000000000000000000000000000000003", "created_at": 170, "tags": [["h", "room-a"]], "content": "{\"type\":\"member_left\",\"actor\":\"aa00000000000000000000000000000000000000000000000000000000000001\"}" }
          ]
        },
        { "forget_except": ["room-a", "room-b", "room-c"], "refused": false }
      ],
      "expect": {
        "events": ["b1", "c1", "y1"],
        "targets": ["y1"],
        "summaries": [],
        "coverage": { "room-b": [[100, 200]], "room-c": [[100, 200]] }
      }
    }
  ]
