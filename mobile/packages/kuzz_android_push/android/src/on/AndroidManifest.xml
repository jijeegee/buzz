<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Asked for on Android 13+ only after the person turns push on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <!-- Data-only {"k":"wake"} messages from the push gateway. -->
        <service
            android:name="app.kuzz.mobile.push.KuzzPushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- No google-services.json: Firebase starts from the build's
             KUZZ_FIREBASE_* defines (KuzzAndroidPushPlugin.configure), and
             FCM never registers a token on its own. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>
</manifest>
