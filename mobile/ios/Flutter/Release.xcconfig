#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Defaults for the iOS Release build. Internal/custom builds (e.g. an
// enterprise-signed distribution) override these without patching tracked
// files by writing `mobile/ios/Flutter/AppOverrides.xcconfig` (gitignored).
BUNDLE_IDENTIFIER = app.kuzz.mobile
APP_DISPLAY_NAME = Kuzz
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = iPhone Developer
KUZZ_DEVELOPMENT_TEAM = EYF346PHUG

// Push support is always present in the iOS artifact. Relay advertisement is
// the rollout authority, so a relay without a valid descriptor remains inert.
KUZZ_APP_GROUP_IDENTIFIER = group.$(BUNDLE_IDENTIFIER)
KUZZ_KEYCHAIN_ACCESS_GROUP = $(BUNDLE_IDENTIFIER)
KUZZ_IOS_PUSH_ENVIRONMENT = production
KUZZ_APP_ATTEST_ENVIRONMENT = production
#include? "AppOverrides.xcconfig"
